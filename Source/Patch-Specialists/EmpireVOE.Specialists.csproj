<Project Sdk="Microsoft.NET.Sdk">
    <!-- Shared settings (framework, language version, RimWorld/Harmony refs) live in ../Directory.Build.props -->
    <PropertyGroup>
        <OutputPath>..\..\Compat\1.7\Specialists\Assemblies</OutputPath>
        <BaseOutputPath>..\..\Compat\1.7\Specialists\Assemblies</BaseOutputPath>
        <AssemblyName>EmpireVOE.Specialists</AssemblyName>
        <RootNamespace>EmpireVOE.Specialists</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Core\EmpireVOE.csproj">
            <Private>False</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <!-- Empire main mod -->
        <Reference Include="Empire">
            <HintPath>..\..\..\Empire\1.7\Assemblies\Empire.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- Empire Specialists submod -->
        <Reference Include="Empire.Specialists">
            <HintPath>..\..\..\Empire-Specialists\1.7\Assemblies\Empire.Specialists.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
