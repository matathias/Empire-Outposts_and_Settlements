<Project Sdk="Microsoft.NET.Sdk">
    <!-- Shared settings (framework, language version, RimWorld/Harmony refs) live in ../Directory.Build.props -->
    <PropertyGroup>
        <OutputPath>..\..\Compat\1.7\VOEPowerGrid\Assemblies</OutputPath>
        <BaseOutputPath>..\..\Compat\1.7\VOEPowerGrid\Assemblies</BaseOutputPath>
        <AssemblyName>EmpireVOE.PowerGrid</AssemblyName>
        <RootNamespace>EmpireVOE.PowerGrid</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Core\EmpireVOE.csproj">
            <Private>False</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <!-- Empire main mod -->
        <Reference Include="Empire">
            <HintPath>..\..\..\Empire\1.7\Assemblies\Empire.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- VEF Outposts framework -->
        <Reference Include="Outposts">
            <HintPath>..\..\References\Outposts.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- Vanilla Outposts Expanded -->
        <Reference Include="VOE">
            <HintPath>..\..\References\VOE.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- VOE Power Outposts (MrHydralisk.VOEPowerGrid) -->
        <Reference Include="VOE Power Grid">
            <HintPath>..\..\References\VOE Power Grid.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
